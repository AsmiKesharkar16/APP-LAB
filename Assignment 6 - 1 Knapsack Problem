# Bottom-Up Approach
def knapsack_bottom_up(values, weights, W):
    n = len(values)

    dp = [[0 for _ in range(W + 1)] for _ in range(n + 1)]

    for i in range(1, n + 1):
        for w in range(W + 1):

            if weights[i - 1] <= w:
                dp[i][w] = max(
                    dp[i - 1][w],
                    dp[i - 1][w - weights[i - 1]] + values[i - 1]
                )
            else:
                dp[i][w] = dp[i - 1][w]

    return dp[n][W]


# Top-Down Approach
def knapsack_top_down(values, weights, W):
    n = len(values)

    dp = [[-1 for _ in range(W + 1)] for _ in range(n + 1)]

    def solve(n, W):
        if n == 0 or W == 0:
            return 0

        if dp[n][W] != -1:
            return dp[n][W]

        if weights[n - 1] > W:
            dp[n][W] = solve(n - 1, W)
        else:
            dp[n][W] = max(
                solve(n - 1, W),
                solve(n - 1, W - weights[n - 1]) + values[n - 1]
            )

        return dp[n][W]

    return solve(n, W)
 
n = int(input("Enter number of items: "))

weights = list(map(int, input("Enter weights: ").split()))
values = list(map(int, input("Enter profits: ").split()))

W = int(input("Enter capacity of knapsack: "))

# Calculate results
bottom_up_result = knapsack_bottom_up(values, weights, W)
top_down_result = knapsack_top_down(values, weights, W)

# Display results
print("\nMaximum Profit using Bottom-Up:", bottom_up_result)
print("Maximum Profit using Top-Down:", top_down_result)
